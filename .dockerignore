# В контекст сборки попадают только перечисленные исходники и конфигурация сборки.
**
!Dockerfile
!.dockerignore
!composer.json
!composer.lock
!yii
!assets/
!assets/**
!commands/
!commands/**
!config/
!config/**
!controllers/
!controllers/**
!filters/
!filters/**
!helpers/
!helpers/**
!mail/
!mail/**
!migrations/
!migrations/**
!models/
!models/**
!modules/
!modules/**
!services/
!services/**
!views/
!views/**
!widgets/
!widgets/**
!web/
!web/**
!frontend/
!frontend/**
!docker/
!docker/php-production.ini
!docker/apache-resources.conf
!docker/apache-bootstrap.conf
!docker/apache-https.conf
!docker/apache-global.conf
!docker/https-bootstrap.html
!docker/https-entrypoint.sh

# Исключения действуют и внутри разрешённых каталогов.
**/.git
**/.env
**/.env.*
**/.npmrc
**/auth.json
**/*.key
**/*.pem
**/*.pfx
**/*.p12
**/*.dump
**/*.dump.*
**/node_modules
**/node_modules/**
frontend/.vite
frontend/.vite/**
frontend/.cache
frontend/.cache/**
frontend/*.tsbuildinfo
web/vue-dist
web/vue-dist/**
web/assets
web/assets/**
web/index-test.php
config/test.php
config/test_db.php
config/__autocomplete.php
